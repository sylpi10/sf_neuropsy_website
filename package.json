{
  "name": "psy-tcc",
  "private": true,
  "version": "1.0.0",
  "description": "Compilation SCSS -> CSS (le CSS compilé est ensuite versionné et servi par AssetMapper).",
  "scripts": {
    "sass:build": "sass assets/styles/style.scss:assets/styles/style.css --no-source-map --style=compressed",
    "sass:watch": "sass --watch assets/styles/style.scss:assets/styles/style.css"
  },
  "devDependencies": {
    "sass": "^1.104.0"
  },
  "allowScripts": {
    "@parcel/watcher": false
  }
}
