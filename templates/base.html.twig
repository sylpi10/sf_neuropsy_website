<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="1xsG3jwxALfLukgMmEtq0CITmIf-Ce3lbgR2Qm4fMdM" />
  <meta name="google-site-verification" content="YoXWOjbcpymHCzSe6C8QDCQkfz8pZpuflG7D_nCb7WQ" />
  <link rel="preload" as="font" type="font/woff2" href="{{ asset('assets/fonts/inter-latin.woff2') }}" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="{{ asset('assets/fonts/fraunces-latin.woff2') }}" crossorigin>
  <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
  <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
  {% block preload %}{% endblock %}
  {% include 'partials/_seo.html.twig' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["Physician", "LocalBusiness"],
    "@id": "{{ site_url }}/#cabinet",
    "name": "Emmanuelle Mir – Psychologue & Neuropsychologue",
    "url": "{{ site_url }}/",
    "image": "{{ site_url ~ asset('assets/images/og-default.jpg') }}",
    "telephone": "+33650576015",
    "email": "emmanuellemir.psy@gmail.com",
    "medicalSpecialty": "Psychiatric",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "133 rue des Écoles, Maison de santé",
      "postalCode": "05230",
      "addressLocality": "La Bâtie-Neuve",
      "addressRegion": "Hautes-Alpes",
      "addressCountry": "FR"
    },
    "geo": {"@type": "GeoCoordinates", "latitude": 44.5666668, "longitude": 6.1925078},
    "areaServed": ["La Bâtie-Neuve", "Gap", "Briançon", "Hautes-Alpes"],
    "openingHoursSpecification": [
      {"@type": "OpeningHoursSpecification", "dayOfWeek": {{ open_days()|map(day => day.schemaDayName)|json_encode|raw }}}
    ]
    {%- set closures = schedule_periods()|filter(period => period.closed) -%}
    {%- if closures is not empty -%},
    "specialOpeningHoursSpecification": [
      {%- for period in closures %}
      {"@type": "OpeningHoursSpecification", "validFrom": "{{ period.startDate|date('Y-m-d') }}", "validThrough": "{{ period.endDate|date('Y-m-d') }}", "opens": "00:00", "closes": "00:00"}{{ loop.last ? '' : ',' }}
      {%- endfor %}
    ]
    {%- endif %}
  }
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content">Aller au contenu</a>
  <header class="site-header" id="top">
    <div class="nav-wrap">
      <a class="brand" href="{{ path('app_home') }}">
        <img src="{{ asset('assets/images/brain.webp') }}" alt="" class="brand-logo" width="40" height="40">
        <span class="brand-name">Emmanuelle Mir<small>Psychologue &amp; Psychothérapeute</small></span>
      </a>

      <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="primaryNav" aria-label="Ouvrir le menu">
        <span></span><span></span><span></span>
      </button>

      <nav class="primary-nav" id="primaryNav">
        {# Menu géré dans l'admin (Menu) : un élément avec des sous-éléments devient un menu déroulant #}
        {% set current_path = app.request.pathInfo %}
        <ul>
          {% for item in menu_items() %}
            {% set children = item.visibleChildren %}
            {% if children is not empty %}
          <li class="has-dropdown">
            <button type="button" class="dropdown-toggle{% if item.highlighted %} formation-navlink{% endif %}" aria-expanded="false">
              {{ item.label }} {{ icon('chevron-down') }}
            </button>
            <ul class="dropdown-menu">
              {% for child in children %}
                {% set url = menu_url(child) %}
                {% if url %}
              <li><a href="{{ url }}"{% if url == current_path %} aria-current="page"{% endif %}{% if child.highlighted %} class="formation-navlink"{% endif %}>{{ child.label }}</a></li>
                {% endif %}
              {% endfor %}
            </ul>
          </li>
            {% else %}
              {% set url = menu_url(item) %}
              {% if url %}
          <li><a href="{{ url }}"{% if url == current_path %} aria-current="page"{% endif %}{% if item.highlighted %} class="formation-navlink"{% endif %}>{{ item.label }}</a></li>
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main-content">
    {% set banners = banner_periods() %}
    {% if banners is not empty %}
    <div class="schedule-banner">
      {% for period in banners %}
      <div class="schedule-banner-item">
        {{ include('partials/_schedule_period.html.twig') }}
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% block body %}{% endblock %}

    {# Sections ajoutées depuis l'admin à la fin d'une page du site (admin > Sections ajoutées aux pages) #}
    {% set extra_blocks = site_page_blocks(app.request.attributes.get('_route')) %}
    {% if extra_blocks is not empty %}
      {{ include('partials/_page_blocks.html.twig', {blocks: extra_blocks, modifier: ' cms-page--appended'}) }}
    {% endif %}
  </main>

  {% set info = site_info() %}
  <footer class="site-footer">
    <div class="footer-grid">
      <address class="footer-item">
        <p class="footer-title">{{ info and info.title ? info.title : 'Emmanuelle Mir, Cabinet de psychologie' }}</p>
        <p>
          {{ info and info.addressLine1 ? info.addressLine1 : 'MAISON DE SANTE' }} <br>
          {{ info and info.addressLine2 ? info.addressLine2 : '133 rue des Ecoles' }} <br>
          {{ info and info.postalCodeCity ? info.postalCodeCity : '05230 LA BATIE NEUVE' }}
        </p>
      </address>

      {% if show_qualiopi() %}
      <div class="footer-item footer-qualiopi">
        <img src="{{ asset('assets/images/qualiopi.webp') }}" alt="Logo certification Qualiopi" width="200" height="107">
      </div>
      {% endif %}

      <div class="footer-item">
        <h2>Pour prendre rendez-vous</h2>
        <ul class="footer-contact">
          <li>{{ icon('phone') }} <a href="tel:{{ info and info.phone ? info.phone|replace({'.': ''}) : '0650576015' }}">{{ info and info.phone ? info.phone : '06.50.57.60.15' }}</a></li>
          <li>{{ icon('envelope') }} <a href="mailto:{{ info and info.email ? info.email : 'emmanuellemir.psy@gmail.com' }}">{{ info and info.email ? info.email : 'emmanuellemir.psy@gmail.com' }}</a></li>
        </ul>
      </div>
    </div>
    <p class="footer-bottom">
      Copyright &copy; 2020-{{ 'now'|date('Y') }} — <a href="https://sylvainpillet.com">S. Pillet</a>
      <span class="footer-sep">|</span><a href="{{ path('app_neuropsychologue_gap') }}">Neuropsychologue près de Gap</a>
      <span class="footer-sep">|</span><a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
      <span class="footer-sep">|</span><a href="{{ asset('assets/documents/CONDITIONS_GENERALES_DE_VENTE.pdf') }}" target="_blank" rel="noopener">CGV<span class="visually-hidden"> (PDF, nouvel onglet)</span></a>
    </p>
  </footer>

  <script src="{{ asset('assets/js/main.js') }}"></script>
</body>
</html>
