<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Psychologue, psychothérapeute Emmanuelle Mir, dans les Hautes-Alpes, Prise en charge enfants, adultes et personnes âgées, cabinet neuropsychologie">
  <meta name="google-site-verification" content="1xsG3jwxALfLukgMmEtq0CITmIf-Ce3lbgR2Qm4fMdM" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css">
  <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
  <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
  {% block preload %}{% endblock %}
  <meta name="description" content="{{ meta_description|default('') }}" />
  <meta name="name" content="{{ meta_name|default('') }}" />
  <title>{% block title %}{{ title|default('Psy TCC') }}{% endblock %}</title>
</head>
<body>
  <a class="skip-link" href="#main-content">Aller au contenu</a>
  <header class="site-header" id="top">
    <div class="nav-wrap">
      <a class="brand" href="{{ path('app_home') }}">
        <img src="{{ asset('assets/images/brain.webp') }}" alt="Logo Emmanuelle Mir" class="brand-logo" width="40" height="40">
        <span class="brand-name">Emmanuelle Mir<small>Psychologue &amp; Psychothérapeute</small></span>
      </a>

      <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="primaryNav" aria-label="Ouvrir le menu">
        <span></span><span></span><span></span>
      </button>

      <nav class="primary-nav" id="primaryNav">
        <ul>
          <li><a href="{{ path('app_home') }}">Accueil</a></li>

          <li class="has-dropdown">
            <button type="button" class="dropdown-toggle" aria-expanded="false">
              Neuropsychologie <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu">
              <li><a href="{{ path('app_neuropsy') }}">Définition</a></li>
              <li><a href="{{ path('app_neuropsy') }}#pour-qui">Pour qui ?</a></li>
              <li><a href="{{ path('app_neuropsy') }}#bilans">Les bilans</a></li>
              <li><a href="{{ path('app_neuropsy') }}#deroulement">Le déroulement</a></li>
              <li><a href="{{ path('app_neuropsy') }}#durée">La durée</a></li>
              <li><a href="{{ path('app_neuropsy') }}#remédiation-cognitive">La remédiation cognitive</a></li>
            </ul>
          </li>

          <li class="has-dropdown">
            <button type="button" class="dropdown-toggle" aria-expanded="false">
              Les T.C.C <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu">
              <li><a href="{{ path('app_tcc') }}#definition">Définition des T.C.C</a></li>
              <li><a href="{{ path('app_tcc') }}#les-techniques">Les techniques</a></li>
              <li><a href="{{ path('app_tcc') }}#pour-qui">Pour qui ?</a></li>
              <li><a href="{{ path('app_tcc') }}#déroulement">Le déroulement</a></li>
            </ul>
          </li>

          <li><a href="{{ path('app_honoraires') }}">Honoraires</a></li>

          <li class="has-dropdown">
            <button type="button" class="dropdown-toggle formation-navlink" aria-expanded="false">
              Se former <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu">
              <li><a href="{{ path('app_organisme_de_formation') }}#organisme-de-formation">Organisme de formation</a></li>
              <li><a href="{{ path('app_organisme_de_formation') }}#formations">Les formations</a></li>
              <li><a href="{{ path('app_organisme_de_formation') }}#inscriptions">Inscriptions</a></li>
              <li><a href="{{ path('app_organisme_de_formation') }}#conditions-generales">Informations pratiques</a></li>
            </ul>
          </li>

          <li><a href="{{ path('app_references') }}">Références</a></li>
          <li><a href="{{ path('app_cabinet') }}">Le cabinet</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main-content">
    {% block body %}{% endblock %}
  </main>

  {% set info = site_info() %}
  <footer class="site-footer">
    <div class="footer-grid">
      <address class="footer-item">
        <p class="footer-title">{{ info and info.title ? info.title : 'Emmanuelle Mir, Cabinet de psychologie' }}</p>
        <p>
          {{ info and info.addressLine1 ? info.addressLine1 : 'MAISON DE SANTE' }} <br>
          {{ info and info.addressLine2 ? info.addressLine2 : '133 rue des Ecoles' }} <br>
          {{ info and info.postalCodeCity ? info.postalCodeCity : '05230 LA BATIE NEUVE' }}
        </p>
      </address>

      <!--<div class="footer-item footer-qualiopi">
        <img src="{{ asset('assets/images/qualiopi.webp') }}" alt="Logo certification Qualiopi" width="200">
      </div>-->

      <div class="footer-item">
        <h4>Pour prendre rendez-vous</h4>
        <ul class="footer-contact">
          <li><i class="fa fa-phone" aria-hidden="true"></i> <a href="tel:{{ info and info.phone ? info.phone|replace({'.': ''}) : '0650576015' }}" title="Téléphone">{{ info and info.phone ? info.phone : '06.50.57.60.15' }}</a></li>
          <li><i class="fa fa-envelope" aria-hidden="true"></i> <a href="mailto:{{ info and info.email ? info.email : 'emmanuellemir.psy@gmail.com' }}" title="E-mail">{{ info and info.email ? info.email : 'emmanuellemir.psy@gmail.com' }}</a></li>
        </ul>
      </div>
    </div>
    <p class="footer-bottom">Copyright &copy; 2020-{{ 'now'|date('Y') }} — <a href="https://sylvainpillet.com">S. Pillet</a></p>
  </footer>

  <script src="{{ asset('assets/js/main.js') }}"></script>
</body>
</html>
