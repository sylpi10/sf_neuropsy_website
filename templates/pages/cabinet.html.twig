{% extends 'base.html.twig' %}

{% block body %}
<div class="page-hero page-hero--cabinet">
  <h1>Le cabinet</h1>
</div>

<section class="cabinet container">
  <address class="address-wrap">
    <div class="address">
      {{ icon('map-marked-alt') }}
      <p>
        MAISON DE SANTE <br>133 rue des Ecoles <br>05230 LA BATIE NEUVE
      </p>
    </div>
  </address>

  <div class="consult">
    <h2>Jours de consultations</h2>
    {% set info = site_info() %}
    <ul>
      {% for day in open_days() %}
      <li>{{ day.dayName }}{% if day.hours %} <span class="consult-hours">{{ day.hours }}</span>{% endif %}</li>
      {% endfor %}
      {% if info and info.consultationNote %}
      <li>{{ info.consultationNote }}</li>
      {% endif %}
    </ul>

    {% for period in schedule_periods() %}
    <div class="schedule-period{% if period.closed %} schedule-period--closed{% endif %}">
      {{ include('partials/_schedule_period.html.twig') }}
    </div>
    {% endfor %}
  </div>

  <div class="maps">
    <div class="frame">
      <iframe title="Plan d'accès : Maison de santé de La Bâtie-Neuve sur Google Maps" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2842.4839010080336!2d6.192507776077526!3d44.56666679287433!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12cb4300321f92ef%3A0x2fe8f32dda2e71f6!2sMaison%20de%20sant%C3%A9%20La%20B%C3%A2tie-Neuve!5e0!3m2!1sfr!2sde!4v1730026444833!5m2!1sfr!2sde" width="530" height="530" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>

    <div class="rdv">
      <h2>Pour prendre rendez-vous</h2>
      <ul>
        <li>{{ icon('phone') }} <a href="tel:0650576015">06.50.57.60.15</a></li>
        <li>{{ icon('envelope') }}
          <a href="mailto:emmanuellemir.psy@gmail.com">emmanuellemir.psy@gmail.com</a>
        </li>
      </ul>
    </div>
  </div>
</section>
{% endblock %}
