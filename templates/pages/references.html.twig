{% extends 'base.html.twig' %}

{% block body %}
<div class="page-hero page-hero--references">
  <h1>Références</h1>
</div>

<section class="references container">
  {# Diplômes et expériences : admin > Références #}
  {% if diplomas is not empty %}
  <h2 class="references-title">Diplômes</h2>

  <div class="diplomas-list">
    {% for diploma in diplomas %}
    <div class="diploma-item{% if diploma.wide %} diploma-item--wide{% endif %}">
      <h3>{% if diploma.showIcon %}{{ icon('user-graduate') }} {% endif %}{{ diploma.title }}</h3>
      {{ diploma.content|page_html }}
      {% if diploma.location %}
      <span class="location">{{ icon('map-marker-alt') }} {{ diploma.location }}</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if current_experiences is not empty or past_experiences is not empty %}
  <h2 class="references-title">Expériences</h2>

  {% for group in [{title: 'Actuelle', items: current_experiences}, {title: 'Antérieures', items: past_experiences}] %}
    {% if group.items is not empty %}
  <div class="experience-item">
    <h3>{{ group.title }}</h3>
    <ul>
      {% for experience in group.items %}
      <li>{{ experience.label }}</li>
      {% endfor %}
    </ul>
  </div>
    {% endif %}
  {% endfor %}
  {% endif %}

  <div class="references-footer">
    <h2>Immatriculations</h2>
    {{ editable_text('references.immatriculations') }}
  </div>
</section>
{% endblock %}
