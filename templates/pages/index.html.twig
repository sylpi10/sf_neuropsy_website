{% extends 'base.html.twig' %}

{% block preload %}
  {% if slides is not empty %}
    {% set first = slides|first %}
    {% set first_img = asset('uploads/slides/' ~ first.imageName) %}
    {% set first_img_mobile = first.mobileImageName ? asset('uploads/slides/' ~ first.mobileImageName) : first_img %}
    {# Slide 1 = candidate LCP : préchargée et posée en CSS ; les suivantes sont chargées en différé par hero_controller.js #}
    {% if first.mobileImageName %}
      <link rel="preload" as="image" href="{{ first_img_mobile }}" media="(max-width: 768px)" fetchpriority="high">
      <link rel="preload" as="image" href="{{ first_img }}" media="(min-width: 769px)" fetchpriority="high">
    {% else %}
      <link rel="preload" as="image" href="{{ first_img }}" fetchpriority="high">
    {% endif %}
    <style>
      .hero-slide--first { background-image: url("{{ first_img }}"); }
      @media (max-width: 768px) { .hero-slide--first { background-image: url("{{ first_img_mobile }}"); } }
    </style>
  {% endif %}
{% endblock %}

{% block body %}
{% if slides is not empty %}
<section class="hero-slider" aria-roledescription="carrousel" aria-label="Présentation du cabinet" data-controller="hero">
  {% for slide in slides %}
    {% if loop.first %}
  <div class="hero-slide hero-slide--first is-active" data-hero-target="slide">
    {% else %}
  <div class="hero-slide" data-hero-target="slide" data-bg="{{ asset('uploads/slides/' ~ slide.imageName) }}"{% if slide.mobileImageName %} data-bg-mobile="{{ asset('uploads/slides/' ~ slide.mobileImageName) }}"{% endif %}>
    {% endif %}
    <div class="hero-caption">
      {% if loop.first %}
      <h1>{{ slide.title|nl2br }}</h1>
      {% else %}
      <h2>{{ slide.title|nl2br }}</h2>
      {% endif %}
      {% if slide.text %}
      <p class="hero-subtitle">{{ slide.text|nl2br }}</p>
      {% endif %}
    </div>
  </div>
  {% endfor %}
  {% if slides|length > 1 %}
  <div class="hero-dots">
    <button class="hero-pause" type="button" aria-label="Mettre le défilement en pause" data-hero-target="pause" data-action="hero#togglePause"></button>
    {% for slide in slides %}
    <button class="hero-dot{% if loop.first %} is-active{% endif %}" type="button" aria-label="Diapositive {{ loop.index }}" data-hero-target="dot" data-action="hero#show" data-hero-index-param="{{ loop.index0 }}"{% if loop.first %} aria-current="true"{% endif %}></button>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% else %}
<h1 class="visually-hidden">Cabinet de psychologie Emmanuelle Mir</h1>
{% endif %}

<section class="home-intro container">
  <div class="home-intro-head">
    <h2>Un accompagnement adapté à chacun</h2>
    <p>Trois axes complémentaires pour comprendre, accompagner et transmettre.</p>
  </div>

  <div class="home-cards">
    <a class="home-card" href="{{ path('app_neuropsy') }}">
      <div class="home-card-icon">{{ icon('brain') }}</div>
      <h3>Neuropsychologie</h3>
      <p>Bilans neuropsychologiques et psychométriques pour mieux comprendre le fonctionnement cognitif, chez l'enfant comme chez l'adulte.</p>
    </a>
    <a class="home-card home-card--accent" href="{{ path('app_tcc') }}">
      <div class="home-card-icon">{{ icon('heart') }}</div>
      <h3>Thérapies T.C.C</h3>
      <p>Des thérapies cognitives et comportementales validées scientifiquement, pour agir sur les pensées, les émotions et les comportements.</p>
    </a>
    <a class="home-card" href="{{ path('app_organisme_de_formation') }}">
      <div class="home-card-icon">{{ icon('graduation-cap') }}</div>
      <h3>Se former</h3>
      <p>L'organisme Psycho-Parent-Alp forme parents, aidants et professionnels autour des troubles du développement et du comportement.</p>
    </a>
  </div>
</section>

<section class="home-highlight">
  <div class="home-highlight-card">
    <h2>Organisme de formation <span>« Psycho-Parent-Alp »</span></h2>
    {% if show_qualiopi() %}
    <img src="{{ asset('images/qualiopi.webp') }}" alt="Logo certification Qualiopi" width="200">
    {% endif %}
    <a class="btn btn-primary" href="{{ path('app_organisme_de_formation') }}">Découvrir les formations</a>
  </div>
</section>
{% endblock %}
