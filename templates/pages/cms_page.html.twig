{% extends 'base.html.twig' %}

{# Page créée dans l'admin (CmsPageController) : bandeau + titre + sections #}
{% block body %}
{% if is_preview %}
<p class="cms-preview-notice" role="status">Aperçu : cette page n'est pas publiée, elle n'est visible que par vous.</p>
{% endif %}

<div class="page-hero{% if not page.heroImageName %} page-hero--local{% endif %}"
  {%- if page.heroImageName %} style="background-image: url('{{ asset('uploads/pages/' ~ page.heroImageName) }}')"{% endif %}>
  <h1>{{ page.title }}</h1>
</div>

{{ include('partials/_page_blocks.html.twig', {blocks: page.blocks}) }}
{% endblock %}
