{% extends 'base.html.twig' %}

{% block body %}
<div class="page-hero page-hero--honoraires">
  <h1>Honoraires</h1>
</div>

<section class="honoraires">
  <div class="wrapper">
    <h2>Honoraires et remboursements</h2>
    <hr>

    <ul>
      {% for fee in fees %}
      <li>
        <h3>{{ fee.title }}&nbsp;:</h3>
        <p>{{ fee.text|nl2br }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endblock %}
