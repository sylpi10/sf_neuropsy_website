<div class="formations-wrapper" id="formations">
  <div class="text-wrapper">
    <h2>Les principaux champs d'expertise:</h2>

    <div class="formation-texts">
      {{ editable_text('formation.formations.expertise') }}

      {% if show_qualiopi() %}
      <img src="{{ asset('assets/images/qualiopi.webp') }}" alt="logo certification qualiopi" width="240">
      {% endif %}
    </div>

    <hr>

    <div class="formations-section">
      <h2>Les formations:</h2>

      <div class="formation-content">

        <h3>{{aidantCategory.title}}</h3>
        <div class="formations-cards-wrapper">
          {% for formation in aidantFormations %}
            {% set is_coming = not formation.status %}
            {% set has_file = formation.fileName %}
            {% set tag = has_file ? 'a' : 'div' %}
            <{{ tag }}
              class="formation-card{% if is_coming %} to-come{% endif %}"
              {% if has_file %}href="{{ asset('uploads/formations/' ~ formation.fileName) }}" download{% endif %}
            >
              <h4> {{ formation.title }} </h4>
              <div class="card-content">
                <span class="duration">{{ icon('clock') }}{{ formation.duration }} jours </span>
                <span class="duration">{{ icon('calendar') }}
                  {% if formation.startsAt %}
                    {{ formation.startsAt }}
                  {% else %}
                    A definir
                  {% endif %}
                </span>
                {% if formation.priceIntra or formation.priceInter %}
                  <span class="duration">{{ icon('tag') }}
                    {% if formation.priceIntra and formation.priceInter %}
                      INTRA: {{ formation.priceIntra }} <br> INTER: {{ formation.priceInter }}
                    {% elseif formation.priceInter %}
                      {{ formation.priceInter }}
                    {% elseif formation.priceIntra %}
                      {{ formation.priceIntra }}
                    {% endif %}
                  </span>
                {% endif %}
              </div>
              {% if has_file %}<span class="download-icon"> {{ icon('download') }}<span class="visually-hidden">Télécharger le programme (PDF)</span></span>{% endif %}
            </{{ tag }}>
          {% else %}
            <p>Aucune formation disponible.</p>
          {% endfor %}
        </div>
      </div>

      <div class="formation-content">
        <h3>{{proCategory.title}}</h3>
        <div class="formations-cards-wrapper">
          {% for formation in proFormations %}
            {% set is_coming = not formation.status %}
            {% set has_file = formation.fileName %}
            {% set tag = has_file ? 'a' : 'div' %}
            <{{ tag }}
              class="formation-card{% if is_coming %} to-come{% endif %}"
              {% if has_file %}href="{{ asset('uploads/formations/' ~ formation.fileName) }}" download{% endif %}
            >
              <h4> {{ formation.title }} </h4>
              <div class="card-content">
                <span class="duration">{{ icon('clock') }}{{ formation.duration }} jours </span>
                <span class="duration">{{ icon('calendar') }}
                  {% if formation.startsAt %}
                    {{ formation.startsAt }}
                  {% else %}
                    A definir
                  {% endif %}
                </span>
                {% if formation.priceIntra or formation.priceInter %}
                  <span class="duration">{{ icon('tag') }}
                    {% if formation.priceIntra %}INTRA: {{ formation.priceIntra }}{% endif %}
                    {% if formation.priceIntra and formation.priceInter %}<br>{% endif %}
                    {% if formation.priceInter %}INTER: {{ formation.priceInter }}{% endif %}
                  </span>
                {% endif %}
              </div>
              {% if has_file %}<span class="download-icon"> {{ icon('download') }}<span class="visually-hidden">Télécharger le programme (PDF)</span></span>{% endif %}
            </{{ tag }}>
          {% else %}
            <p>Aucune formation disponible.</p>
          {% endfor %}
        </div>
      </div>
    </div>

    <hr>

    <div class="text proposed-formations">
      <div class="text">
        <h2>Les formations et interventions proposée</h2>
        <div class="first-para">
          <div class="first-para-text">{{ editable_text('formation.formations.parents') }}</div>
          <img src="{{ asset('assets/images/formation/alps_pic3.webp') }}" class="mountain-picture" alt="" width="500" height="260">
        </div>

        {{ editable_text('formation.formations.autres') }}

        {% if show_qualiopi() %}
        <img src="{{ asset('assets/images/qualiopi.webp') }}" alt="logo certification qualiopi" width="240">
        {% endif %}
      </div>
    </div>
  </div>
</div>
