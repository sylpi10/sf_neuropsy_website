<div class="inscription-wrapper" id="inscriptions">
  <div class="text-wrapper">
    <h2>Pour s'inscrire</h2>
    <div class="text">
      {{ editable_text('formation.inscription.intro') }}
    </div>

    <div class="parcours-wrapper">
      <h2>Parcours de formation:</h2>

      <div class="text">
        <h3 class="text-title">1 inscription</h3>
        <p>- Remplir le bulletin d’inscription à télécharcher : <a class="download-link" href="{{ asset('assets/documents/BULLETIN_D_INSCRIPTION_AUX_FORMATIONS.pdf') }}" download> {{ icon('download') }} Télécharger le bulletin</a> </p>
        {{ editable_text('formation.inscription.etape1') }}
      </div>

      <div class="text">
        <h3 class="text-title">2 Confirmation et retour de l’organisme de formation</h3>
        {{ editable_text('formation.inscription.etape2') }}
      </div>

      <div class="text">
        <h3>3 Retour du stagiaire ou de la structure</h3>
        {{ editable_text('formation.inscription.etape3') }}
      </div>

      <div class="text">
        <h3>4 Formation</h3>
        {{ editable_text('formation.inscription.etape4') }}
      </div>
      <div class="text">
        <h3>5 Attestation</h3>
        {{ editable_text('formation.inscription.etape5') }}
      </div>
      <div class="text">
        <h3>6 Bilan et modalités d’évaluation</h3>
        {{ editable_text('formation.inscription.etape6') }}
      </div>

      {% if show_qualiopi() %}
      <img src="{{ asset('assets/images/qualiopi.webp') }}" alt="logo certification qualiopi" width="240">
      {% endif %}
    </div>
  </div>
</div>
